02 (AI-Scientist-v2) patch for the shared file real_eval/scripts/psydefdetect_framework_fullrun.sh
Applied at run time by real_eval/adapters/shared_layer_overlay.py; the shared file itself
stays byte-identical to upstream.

  * native inputs are rendered through the 02 overlay of the PsyDefDetect generator
  * EXIT trap keeps the real exit code; a failed handoff validation writes a terminal state and
    exits 44 (868d755, 2026-09-04)
  * PSYDEFDETECT_KIMI_ALLOW_DIRECT=1: opt-in for a direct kimi provider; default off
    (2e0281d, 2026-09-04)
  * REAL_EVAL_ALLOWED_GPUS: opt-in device-level GPU confinement; unset keeps --gpus all
    (04b49db, 2026-09-14)
  * a timeout (124/137) no longer discards a run that delivered conforming artifacts
    (e656e4b, 2026-09-03)

--- a/real_eval/scripts/psydefdetect_framework_fullrun.sh
+++ b/real_eval/scripts/psydefdetect_framework_fullrun.sh
@@ -64,13 +64,13 @@
   fi
 }
 cleanup_relay() {
-  local rc=$?
+  local rc=${1:-$?}
   set +e
   [[ "$RELAY_STARTED" == "1" ]] && docker rm -f "$RELAY_NAME" >/dev/null 2>&1
   [[ "$NETWORK_CREATED" == "1" ]] && docker network rm "$RELAY_NETWORK" >/dev/null 2>&1
   exit "$rc"
 }
-trap 'check_template_clean; cleanup_relay' EXIT
+trap '_exit_rc=$?; check_template_clean || _exit_rc=$?; cleanup_relay "$_exit_rc"' EXIT
 
 write_state() {
   local status="$1"
@@ -115,7 +115,7 @@
     write_state "blocked" "Kimi PsyDefDetect evaluation model must be kimi-k2.6, got: $EVAL_MODEL" 27
     exit 27
   fi
-  if [[ "$FRAMEWORK_ISOLATED_RELAY" != "1" && ( "$PROVIDER_CONFIG" != "$ROOT/api/codex_kimi_k27_code_relay_container.toml" || "$PROVIDER_BASE_URL" != "http://host.docker.internal:8787/v1" ) ]]; then
+  if [[ "${PSYDEFDETECT_KIMI_ALLOW_DIRECT:-0}" != "1" && "$FRAMEWORK_ISOLATED_RELAY" != "1" && ( "$PROVIDER_CONFIG" != "$ROOT/api/codex_kimi_k27_code_relay_container.toml" || "$PROVIDER_BASE_URL" != "http://host.docker.internal:8787/v1" ) ]]; then
     write_state "blocked" "Kimi PsyDefDetect requires the canonical Docker-bridge relay provider config" 28
     exit 28
   fi
@@ -133,7 +133,7 @@
 if [[ "$FRAMEWORK_ISOLATED_RELAY" == "1" ]]; then
   INPUT_PROVIDER_BASE_URL="http://psydef-relay:8787/v1"
 fi
-python3 "$ROOT/automation/scripts/generate_psydefdetect_native_inputs.py" \
+python3 "$ROOT/real_eval/adapters/shared_layer_overlay.py" generate ai_scientist_v2 automation/scripts/generate_psydefdetect_native_inputs.py \
   --output-root "$INPUT_ROOT" \
   --dataset-root "$DATASET_ROOT" \
   --contract-file "$CONTRACT_FILE" \
@@ -294,7 +294,15 @@
   docker_cmd+=(--network "$RELAY_NETWORK")
 fi
 if [[ "$FRAMEWORK_DISABLE_GPU" != "1" ]]; then
-  docker_cmd+=(--gpus all)
+  if [[ -n "${REAL_EVAL_ALLOWED_GPUS:-}" ]]; then
+    # Device-level GPU confinement, same opt-in pattern as the ARC runner
+    # (see arc_framework_fullrun.sh): callers that declare their allowed
+    # GPUs get a docker-level device boundary workers cannot cross. Unset
+    # keeps --gpus all for every other caller.
+    docker_cmd+=(--gpus "device=${REAL_EVAL_ALLOWED_GPUS}")
+  else
+    docker_cmd+=(--gpus all)
+  fi
 fi
